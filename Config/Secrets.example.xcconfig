// Secrets.example.xcconfig — COMMITTED template.
//
// Setup:
//   1. Copy this file to `Config/Secrets.xcconfig` (gitignored).
//   2. Replace DEMO_KEY with your personal key from https://api.nasa.gov.
//
// xcconfig gotcha: `//` starts a comment. Never put `//` inside a value
// (store hosts WITHOUT a scheme, e.g. `api.nasa.gov`, not `https://...`).
// DEMO_KEY works but is limited to 30 req/hour, 50 req/day — fine for a
// smoke test, but it WILL rate-limit (429) under normal use.

NASA_API_KEY = DEMO_KEY

// Purchasely API key from the Purchasely Console > App Settings.
PURCHASELY_API_KEY = your-purchasely-api-key
